{
  "name": "@adviverse/electron",
  "version": "0.1.0",
  "description": "Electron main-process + preload bridge for Adviverse desktop ads: opens ad clicks in the system browser (http(s) only, contextIsolation-safe).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "electron": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^30.0.0",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "adviverse",
    "ads",
    "electron",
    "desktop"
  ]
}
